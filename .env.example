# ==============================================================================
# Career Assistant Configuration (.env.example)
# Copy this file to .env to customize local behavior.
# ==============================================================================

# Ollama / LLM Endpoint
# Default points to local Ollama instance running Qwen 2.5
OLLAMA_HOST=http://localhost:11434

# Model identifier (e.g. qwen2.5:7b, qwen2.5:14b, llama3:8b)
MODEL_NAME=qwen2.5:7b

# Request timeout in milliseconds before triggering deterministic Fallback
LLM_TIMEOUT_MS=4000

# Set to true to force deterministic extractive fallback (0 external dependencies)
# Useful for offline review, air-gapped CI/CD, or systems without local Ollama
DISABLE_LLM=false

# SQLite FTS5 index file path
SQLITE_DB_PATH=facts.db
